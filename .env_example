# ========================================
# PostgreSQL Database Configuration
# ========================================

# Суперпользователь PostgreSQL (обычно 'postgres' для разработки)
POSTGRES_USER=postgres

# Пароль для пользователя PostgreSQL (обязательно измените!)
POSTGRES_PASSWORD=your_secure_password_here

# Хост БД (для Docker используйте имя сервиса, например 'postgres')
POSTGRES_HOST=postgres

# Порт PostgreSQL (по умолчанию 5432)
POSTGRES_PORT=5432

# Имя базы данных (измените под свой проект)
POSTGRES_DB=disinfection_db

# ========================================
# Flask Application Configuration
# ========================================

FLASK_APP=app

# Секретный ключ для сессий (сгенерируйте новый!)
SECRET_KEY=your_flask_secret_key_here

# Режим работы (development/production)
FLASK_ENV=development

# Отладочный режим (только для разработки!)
# FLASK_DEBUG=True

# ========================================
# CORS Configuration
# ========================================

# Разрешённые источники для SocketIO/CORS (через запятую).
# В development режиме используйте '*' для доступа с любых устройств.
# В production укажите конкретные домены.
# Пример: CORS_ALLOWED_ORIGINS=https://example.com,https://admin.example.com
# Для доступа с мобильных устройств в локальной сети используйте '*'
CORS_ALLOWED_ORIGINS=*

# ========================================
# Admin Account Configuration
# ========================================

# Пароль для учётной записи администратора (создаётся при первом запуске).
# Если не задан — будет сгенерирован случайный 16-символьный пароль и выведен в лог.
# ADMIN_PASSWORD=your_secure_admin_password_here

# ========================================
# Дополнительные настройки (опционально)
# ========================================

# URL для подключения к БД (автогенерация из параметров выше)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ========================================
# REST API Configuration
# ========================================
JWT_SECRET_KEY=a8K9xQ3mN7vL2pR5tW1yZ4cB6eH0jF8gD3iO5uS7nM9qX2wT4vP6rY8bA1kL5hC0dE7fG
FEATURE_FLAG_API_V1_ENABLED=True
FEATURE_FLAG_JWT_AUTH_ENABLED=True

# ========================================
# Redis Configuration
# ========================================
REDIS_URL=redis://redis:6379/0
CACHE_TYPE=RedisCache
CACHE_DEFAULT_TIMEOUT=300
RATELIMIT_STORAGE_URL=redis://redis:6379/1

